.DS_Store

# Python
__pycache__/
*.pyc
.venv*/
**/.venv*/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Node
node_modules/

# Generated types (regenerate via schema/generate.sh once codegen bundling lands)
schema/generated/

# Build artifact (regenerated by build_and_validate.py)
packs/ca-foundation-qa/pack.json

# Operator-local reference material. Never tracked, never distributed.
/syllabus/
syllabus/

# Design-team working area (vendor inbox; ported artifacts land in docs/brand/ and app/)
/design-team/

# Internal working docs: operator and build-agent material (audit, master plan,
# design intake, session bridges). Not part of the public doc surface. See internal/MOVES.md.
/internal/

# Python packaging artifact (pip install . in repo root)
*.egg-info/

# Engine build output
engine-ts/dist/

# App build output (Vite production build; built in CI as a verification gate; deploy job pending)
app/dist/

# Cross-check generated cases (deterministic; regenerate via crosscheck/generate_cases.py)
crosscheck/cases.json

# Pilot staging (transient; accepted items promote into the pack, reports persist to audit/)
packs/ca-foundation-qa/staging/

# Generated pack manifest (emitted by build_and_validate.py beside pack.json)
packs/ca-foundation-qa/pack.manifest.json

# Local agent/editor workspaces and caches: never tracked
.claude/
.vite/
**/.vite/
coverage/
docs/audit/