{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pinaka.dev/schema/uqs-core-1.json",
  "title": "Pinaka UQS Core — exam-agnostic item contract (v1)",
  "description": "TIER: CORE. The structural contract shared by every exam. Exam-specific narrowing — the exam value, id namespace, option count, difficulty scale, ext shape, asset policy — lives in a Profile schema that composes this one via allOf + $ref (see profiles/<exam>/). This file expresses STRUCTURAL invariants only. Cross-record invariants (content_hash recompute, pack-level uniqueness, tests[] and misconception referential integrity against a Profile's taxonomy and canon, asset sanitization) are enforced by the shared validator, not here, because JSON Schema cannot express them. Core changes rarely; the Profile absorbs per-exam variation. Surface: single_best, numeric_entry. Stimulus/grouping, multi_select are deferred until an exam needs them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "content_hash",
    "exam",
    "lang",
    "pool",
    "verification_status",
    "provenance",
    "tests",
    "difficulty_label",
    "taxonomy_version",
    "item_type",
    "answer_key",
    "stem",
    "explanation"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^(sd|vlt|arn)_[a-z0-9]+_[a-z0-9]+_\\d{6}$" },
    "schema_version": { "const": "uqs-1" },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "exam": { "type": "string", "minLength": 1 },
    "lang": { "type": "string", "pattern": "^[a-z]{2}(-[A-Za-z0-9]{2,8})*$", "default": "en" },
    "pool": { "enum": ["seed", "vault", "arena"] },
    "verification_status": {
      "enum": ["draft", "model_audited", "machine_verified", "human_reviewed", "published", "quarantined"]
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "tests": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "difficulty_label": { "type": "string", "minLength": 1 },
    "taxonomy_version": { "type": "integer", "minimum": 1 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "item_type": { "enum": ["single_best", "numeric_entry"] },
    "options": { "type": "array" },
    "answer_key": { "type": "object" },
    "stem": { "type": "string", "minLength": 1 },
    "explanation": { "type": "string", "minLength": 50 },
    "expected_seconds": { "type": "integer", "minimum": 1 },
    "per_option_rationale": {
      "type": "array",
      "items": { "$ref": "#/$defs/per_option_rationale" }
    },
    "common_errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/common_error" }
    },
    "empirical": { "$ref": "#/$defs/empirical" },
    "ext": { "type": "object" },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } }
  },
  "allOf": [
    {
      "if": {
        "required": ["item_type"],
        "properties": { "item_type": { "const": "single_best" } }
      },
      "then": {
        "required": ["options"],
        "properties": {
          "options": {
            "type": "array",
            "minItems": 2,
            "items": { "$ref": "#/$defs/option" }
          },
          "answer_key": { "$ref": "#/$defs/answer_key_single" },
          "common_errors": false
        }
      }
    },
    {
      "if": {
        "required": ["item_type"],
        "properties": { "item_type": { "const": "numeric_entry" } }
      },
      "then": {
        "properties": {
          "options": false,
          "per_option_rationale": false,
          "answer_key": { "$ref": "#/$defs/answer_key_numeric" }
        }
      }
    }
  ],
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "license", "created"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "parent_id": {
          "type": ["string", "null"],
          "pattern": "^(sd|vlt|arn)_[a-z0-9]+_[a-z0-9]+_\\d{6}$"
        },
        "generator": { "type": "string" },
        "attribution": { "type": "string" },
        "created": { "type": "string", "format": "date" },
        "updated": { "type": "string", "format": "date" }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "text"],
      "properties": {
        "key": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "answer_key_single": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correct"],
      "properties": { "correct": { "type": "integer", "minimum": 1 } }
    },
    "answer_key_numeric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "tol_abs", "tol_rel"],
      "properties": {
        "value": { "type": "number" },
        "tol_abs": { "type": "number", "minimum": 0 },
        "tol_rel": { "type": "number", "minimum": 0 },
        "unit": { "type": "string" }
      }
    },
    "per_option_rationale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option_key", "verdict", "rationale"],
      "properties": {
        "option_key": { "type": "integer", "minimum": 1 },
        "verdict": { "enum": ["correct", "incorrect"] },
        "rationale": { "type": "string", "minLength": 1 },
        "misconception": { "type": "string" }
      }
    },
    "common_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "misconception", "rationale"],
      "properties": {
        "value": { "type": "number" },
        "misconception": { "type": "string" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "empirical": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "difficulty_b": { "type": ["number", "null"] },
        "discrimination_a": { "type": ["number", "null"] },
        "guessing_c": { "type": ["number", "null"] },
        "p_value": { "type": ["number", "null"] },
        "avg_seconds": { "type": ["number", "null"] },
        "n_responses": { "type": "integer", "minimum": 0 },
        "community_rating": { "type": ["number", "null"] },
        "community_rating_count": { "type": "integer", "minimum": 0 },
        "calibration_status": { "enum": ["none", "provisional", "calibrated"] },
        "last_calibrated": { "type": ["string", "null"], "format": "date" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner_type", "owner_id", "kind", "mime", "path", "content_hash", "alt"],
      "properties": {
        "id": { "type": "string" },
        "owner_type": { "const": "item" },
        "owner_id": { "type": "string" },
        "kind": { "enum": ["image", "diagram"] },
        "mime": { "enum": ["image/svg+xml", "image/png", "image/jpeg"] },
        "path": { "type": "string", "minLength": 1 },
        "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "alt": { "type": "string", "minLength": 1 },
        "caption": { "type": "string" }
      }
    }
  }
}
