      "item_type": "single_best",
      "expected_seconds": 75,
      "stem": "Priya deposits Rs 20,000 in a bank that offers 10% per annum interest compounded half-yearly. What is the compound interest earned at the end of 1 year?",
      "options": [
        {
          "key": 1,
          "text": "Rs 2,050"
        },
        {
          "key": 2,
          "text": "Rs 2,000"
        },
        {
          "key": 3,
          "text": "Rs 4,200"
        },
        {
          "key": 4,
          "text": "Rs 2,100"
        }
      ],
      "answer_key": {
        "correct": 1
      },
      "per_option_rationale": [
        {
          "option_key": 1,
          "verdict": "correct",
          "rationale": "Rate per half-year = 5%; A = 20000 * (1.05)^2 = 20000 * 1.1025 = 22,050; CI = 22,050 - 20,000 = 2,050."
        },
        {
          "option_key": 2,
          "verdict": "incorrect",
          "rationale": "Applies simple interest at 10% for 1 year (20000 * 0.10 * 1 = 2,000) instead of compounding half-yearly.",
          "misconception": "compound_interest_confusion"
        },
        {
          "option_key": 3,
          "verdict": "incorrect",
          "rationale": "Uses the full annual rate of 10% as the periodic rate for each half-year: 20000 * (1.10)^2 - 20000 = 4,200.",
          "misconception": "rate_period_mismatch"
        },
        {
          "option_key": 4,
          "verdict": "incorrect",
          "rationale": "Rounds (1.05)^2 = 1.1025 prematurely to 1.105, giving 20000 * 1.105 - 20000 = 2,100.",
          "misconception": "arithmetic_slip"
        }
      ],
      "explanation": "Half-yearly compounding means r = 10%/2 = 5% per period and n = 2 periods. A = 20000 * (1.05)^2 = 22,050, so CI = 2,050. Dividing the rate by the number of periods per year is the key step; using the full annual rate per period overstates the interest.",
      "empirical": {
        "calibration_status": "none",
        "n_responses": 0
      },
