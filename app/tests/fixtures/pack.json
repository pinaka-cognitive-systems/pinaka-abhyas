      "item_type": "single_best",
      "expected_seconds": 75,
      "stem": "A project team needs to select a sub-group of 3 members from a pool of 8 candidates. In how many distinct ways can the sub-group be formed?",
      "options": [
        {
          "key": 1,
          "text": "84"
        },
        {
          "key": 2,
          "text": "168"
        },
        {
          "key": 3,
          "text": "336"
        },
        {
          "key": 4,
          "text": "56"
        }
      ],
      "answer_key": {
        "correct": 4
      },
      "per_option_rationale": [
        {
          "option_key": 4,
          "verdict": "correct",
          "rationale": "C(8,3) = 8! / (3! x 5!) = (8 x 7 x 6) / (3 x 2 x 1) = 336 / 6 = 56."
        },
        {
          "option_key": 1,
          "verdict": "incorrect",
          "rationale": "Selecting from 9 candidates instead of 8 gives C(9,3) = 84, an off-by-one error in the group size.",
          "misconception": "off_by_one"
        },
        {
          "option_key": 2,
          "verdict": "incorrect",
          "rationale": "Dividing 8 x 7 x 6 = 336 by 2! instead of 3! gives 168; the full factorial of the selection size was not used.",
          "misconception": "permutation_combination_confusion"
        },
        {
          "option_key": 3,
          "verdict": "incorrect",
          "rationale": "Computing P(8,3) = 8 x 7 x 6 = 336 counts ordered arrangements, not unordered groups.",
          "misconception": "permutation_combination_confusion"
        }
      ],
      "explanation": "Because the sub-group has no internal ordering, use combinations: C(8,3) = 8! / (3! x 5!) = (8 x 7 x 6) / 6 = 56. Dividing by 3! (not 2! or 1!) removes all orderings of the chosen 3 members.",
      "empirical": {
        "calibration_status": "none",
        "n_responses": 0
      },
      "ext": {
